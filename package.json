{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "validate:registries": "tsx --tsconfig tsconfig.app.json scripts/validate-registries.ts",
    "validate:permissions": "tsx --tsconfig tsconfig.app.json scripts/validate-permissions.ts",
    "validate:architecture": "tsx --tsconfig tsconfig.app.json scripts/validate-architecture.ts",
    "circular": "madge --circular src",
    "deadcode": "ts-prune",
    "audit": "npm audit",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run validate:registries && npm run validate:permissions && npm run validate:architecture && npm run circular && npm run deadcode"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "madge": "^8.0.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "ts-prune": "^0.10.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
